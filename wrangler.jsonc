{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arash4627",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6d3d65ac-7d4a-4fff-aa19-0fd1299340cf","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "877614a2d9dc4b179d524d68e88b0925" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
